# Local Docker configuration. Copy to .env and replace all placeholder values.
APP_NAME="BISAVUNMA Fiyat Takip"
DEFAULT_LOCALE=tr_TR
APP_URL=http://localhost:8012
APP_KEY=base64:GENERATE_A_NEW_LARAVEL_KEY
APP_ENV=production
APP_DEBUG=false
REQUIRE_HTTPS=false
PDF_GENERATOR=snappdf
PHANTOMJS_PDF_GENERATION=false
TRUSTED_PROXIES=*

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=fiyattakip
DB_USERNAME=fiyattakip
DB_PASSWORD=replace_with_a_long_database_password
DB_ROOT_PASSWORD=replace_with_a_different_long_root_password

CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
FILESYSTEM_DISK=debian_docker
IS_DOCKER=true

# The primary owner/admin created at first boot. Never commit a real password.
IN_USER_EMAIL=admin@example.com
IN_PASSWORD=replace_with_a_long_admin_password

MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="BISAVUNMA Fiyat Takip"
