# BISAVUNMA Fiyat Takip - canlı ortam ayarları (docker-compose.prod.yml).
# Bu dosyayı sunucuda .env.production adıyla kopyalayın ve "degistir" geçen
# her değeri doldurun. .env.production Git'e gönderilmez.
# Ayrıntılı rehber: docs/canli-kurulum.md

# --- Alan adı ve HTTPS ------------------------------------------------------
# DNS'te bu alan adının A kaydı sunucunun IP adresini göstermelidir.
APP_DOMAIN=teklif.bisavunma.com
# Let's Encrypt sertifika bildirimleri için BT e-posta adresi.
ACME_EMAIL=degistir@bisavunma.com

# --- Uygulama ---------------------------------------------------------------
APP_NAME="BISAVUNMA Fiyat Takip"
APP_URL=https://teklif.bisavunma.com
# Üretmek için: echo "base64:$(openssl rand -base64 32)"
APP_KEY=base64:degistir
APP_ENV=production
APP_DEBUG=false
DEFAULT_LOCALE=tr_TR
# HTTPS'i Caddy zorunlu kılar; uygulama X-Forwarded-Proto başlığına güvenir.
REQUIRE_HTTPS=false
TRUSTED_PROXIES=*
SESSION_SECURE_COOKIE=true
PDF_GENERATOR=snappdf
PHANTOMJS_PDF_GENERATION=false
IS_DOCKER=true

# --- Veritabanı (yalnızca iç ağda) ------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=fiyattakip
DB_USERNAME=fiyattakip
DB_PASSWORD=degistir_uzun_rastgele_parola
DB_ROOT_PASSWORD=degistir_farkli_uzun_rastgele_parola

# --- Önbellek, oturum, kuyruk -----------------------------------------------
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
FILESYSTEM_DISK=debian_docker

# --- İlk yönetici (yalnızca ilk açılışta kullanılır) ------------------------
IN_USER_EMAIL=degistir@bisavunma.com
IN_PASSWORD=degistir_en_az_16_karakter

# --- E-posta (teklif / proforma gönderimi) ----------------------------------
# bisavunma.com e-posta sunucusunun SMTP bilgileri.
MAIL_MAILER=smtp
MAIL_HOST=degistir.smtp.sunucusu
MAIL_PORT=587
MAIL_USERNAME=teklif@bisavunma.com
MAIL_PASSWORD=degistir
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=teklif@bisavunma.com
MAIL_FROM_NAME="BISAVUNMA"
